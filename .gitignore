# Obsidian app state — machine-specific, not part of the kit
.obsidian/

# OS junk
.DS_Store
Thumbs.db

# Scratch / staging artifacts — never shipped
*.scratch.md
SCRUB_LEDGER*
REWRITE_SPEC.md

# Local permission overrides — personal, not shipped
.claude/settings.local.json

# Claude Code runtime lock files
.claude/scheduled_tasks.lock

# Python bytecode
__pycache__/
*.pyc

# Real trips stay local: only the template and the invented example are tracked
trips/*
!trips/_template/
!trips/lisbon-8d/

# Tools: dependencies, outputs, sandbox scratch, local Node
tools/node_modules/
tools/.node/
tools/out/
tools/airbnb/scratch/*
!tools/airbnb/scratch/.gitkeep
.env
