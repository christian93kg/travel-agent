{
  "name": "travel-agent-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Flight discovery (Google Flights via headless Chromium) and sandboxed Airbnb search for the travel-agent plan-trip skill.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "setup": "./setup.sh",
    "flights:one": "node flights/tfs.js",
    "flights:batch": "node flights/batch.js",
    "flights:specs": "node flights/specgen.js",
    "flights:day": "node flights/day.js",
    "flights:summary": "node flights/summ.js",
    "airbnb:selftest": "./airbnb/selftest.sh",
    "airbnb:sweep": "node airbnb/sweep.js",
    "airbnb:zones": "node airbnb/zones.js",
    "airbnb:details": "node airbnb/details.js"
  },
  "dependencies": {
    "@openbnb/mcp-server-airbnb": "0.3.0",
    "playwright": "1.64.1"
  }
}
